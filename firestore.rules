rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'nicolasg20112011@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'storeName', 'tagline', 'logoUrl', 'whatsappNumber',
          'currency', 'accentColor', 'seeded', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeName', 'tagline', 'logoUrl', 'whatsappNumber',
          'currency', 'accentColor', 'seeded', 'updatedBy', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80
        && data.tagline is string && data.tagline.size() <= 160
        && data.logoUrl is string && data.logoUrl.size() <= 250000
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 25 && data.whatsappNumber.matches('^[0-9+\\s\\-()]*$')
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8
        && data.accentColor is string && data.accentColor.size() == 7 && data.accentColor.matches('^#[0-9a-fA-F]{6}$')
        && data.seeded is bool
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'name', 'description', 'price', 'compareAtPrice',
          'category', 'imageUrl', 'inStock', 'published',
          'featured', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'description', 'price', 'compareAtPrice',
          'category', 'imageUrl', 'inStock', 'published',
          'featured', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 1000
        && (data.price is int || data.price is float) && data.price >= 0 && data.price <= 1000000000
        && (data.compareAtPrice is int || data.compareAtPrice is float) && data.compareAtPrice >= 0 && data.compareAtPrice <= 1000000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.imageUrl is string && data.imageUrl.size() <= 250000
        && data.inStock is bool
        && data.published is bool
        && data.featured is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'addedBy', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128 && data.addedBy == request.auth.uid
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'store';
      allow list: if false;
      allow create: if isVerified() && isValidId(settingId) && settingId == 'store' && isValidStoreSettings(incoming()) && isAdmin();
      allow update: if isVerified() && isValidId(settingId) && settingId == 'store'
        && isValidStoreSettings(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName', 'tagline', 'logoUrl', 'whatsappNumber',
          'currency', 'accentColor', 'seeded', 'updatedBy', 'updatedAt'
        ])
        && isAdmin();
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isBootstrappedAdmin();
      allow create: if isVerified() && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if isVerified() && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'price', 'compareAtPrice',
          'category', 'imageUrl', 'inStock', 'published',
          'featured', 'updatedAt'
        ])
        && isAdmin();
      allow delete: if isVerified() && isValidId(productId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if false;
      allow create: if isVerified() && isValidId(adminId) && isValidAdminUser(incoming()) && isBootstrappedAdmin();
      allow update: if false;
      allow delete: if isVerified() && isValidId(adminId) && isBootstrappedAdmin();
    }

    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }
  }
}
